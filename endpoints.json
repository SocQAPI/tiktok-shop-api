      "method": "POST",
      "path": "/v1/tiktok-shop/products",
      "payload": "payloads/products.json",
      "launchedAt": "2026-07-20",
      "price": "0.7 credits ($0.0035) per result",
      "billing": {
        "baseCredits": 0,
        "mode": "base_plus_result",
        "resultUnitSize": 1,
        "resultUnitCredits": 0.7,
        "estimateResultCount": 100,
        "emptyResultPolicy": "base_only"
      },
      "docsUrl": "https://docs.socq.ai/api-manual/tiktok-shop/products",
      "landingUrl": "https://socq.ai/apis/tiktok-shop/products",
      "required": [
        "url"
      ],
      "requiredAnyOf": [],
      "mutuallyExclusive": [],
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1
          },
          "results_limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2000
          },
          "sort_by": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "A public content or product URL."
          }
        },
        "required": [
          "url"
        ]
      }
    },
    {
      "publicId": "tiktok-shop/product",
      "name": "TikTok Shop Product API",
      "description": "Retrieve one public TikTok Shop product from a PDP URL, returning normalized product identity, seller, price, visible commerce signals, media, categories, and SKU data.",
      "method": "POST",
      "path": "/v1/tiktok-shop/product",
      "payload": "payloads/product.json",
      "launchedAt": "2026-07-20",
      "price": "0.7 credits ($0.0035) per result",
      "billing": {
        "baseCredits": 0,
        "mode": "base_plus_result",
        "resultUnitSize": 1,
        "resultUnitCredits": 0.7,
        "estimateResultCount": 1,
        "estimateInputField": "url",
        "emptyResultPolicy": "base_only"
      },
      "docsUrl": "https://docs.socq.ai/api-manual/tiktok-shop/product",
      "landingUrl": "https://socq.ai/apis/tiktok-shop/product",
      "required": [
        "url"
      ],
      "requiredAnyOf": [],
      "mutuallyExclusive": [],
      "requestSchema": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "region": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "US"
            ],
            "default": "US",
            "description": "Currently available for the US region only. Other regions are unavailable for this endpoint."
          },
          "url": {
            "type": "string",
            "minLength": 1,
            "description": "A public content or product URL."
          }
        },
        "required": [
          "url"
        ],
        "description": "This endpoint currently supports US only. Omit region or set it to US; other regions are rejected before task creation."
      }
    },
